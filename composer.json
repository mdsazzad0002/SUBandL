{
    "name": "subandl/subandl",
    "description": "SUBandL — Software Update, Backup and License client for Laravel applications.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "license", "subscription", "updater", "backup"],
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "symfony/process": "^6.0|^7.0|^8.0"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Render the subscription pages with your own Inertia components (ui.driver = inertia)."
    },
    "autoload": {
        "psr-4": {
            "SUBandL\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SUBandL\\SUBandLServiceProvider"
            ],
            "aliases": {
                "SUBandL": "SUBandL\\Facades\\SUBandL"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
